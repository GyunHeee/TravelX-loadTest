# infra 레포(vietnam-internship/infra)의 k8s/configmap.env + k8s/secret.env를
# 합쳐서 env/configmap.env로 로컬에 직접 만드세요 (이 파일은 값이 없는 템플릿입니다).
# DEV_AUTH_ENABLED만 true로 오버라이드하고, 나머지는 실제 prod 값을 그대로 씁니다 —
# 그래야 HikariCP 풀 크기·Tomcat 스레드·가상 스레드 설정이 실제 배포와 동일해집니다.

DB_HOST=mysql
DB_PORT=3306
DB_URL=jdbc:mysql://mysql:3306/travelx?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

JWT_SECRET=

SPRING_PROFILES_ACTIVE=prod
SPRING_PORT=8080

TOMCAT_MAX_CONNECTIONS=20000
TOMCAT_MAX_THREADS=600
TOMCAT_MIN_SPARE_THREADS=100

# 부하테스트 시드용 유저를 실제 Google OAuth 없이 만들기 위해 로컬 테스트에서만 true로 둔다.
# (실제 prod configmap엔 false로 돼 있음 — 이 값만 의도적으로 오버라이드하는 것)
DEV_AUTH_ENABLED=true
AUTH_COOKIE_SAME_SITE=None

HIKARI_MAX_POOL_SIZE=8
HIKARI_MIN_IDLE=8
HIKARI_CONNECTION_TIMEOUT=3000
HIKARI_VALIDATION_TIMEOUT=3000
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=600000
HIKARI_KEEPALIVE_TIME=60000

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

DDL_AUTO=validate
VIRTUAL_THREADS_ENABLED=true

ASYNC_CORE_POOL_SIZE=5
ASYNC_MAX_POOL_SIZE=5
ASYNC_QUEUE_CAPACITY=100

LOG_FILE_PATH=/app/logs/app.log

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EXCHANGERATE_API_KEY=
EXCHANGERATE_API_URL=
